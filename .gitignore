# Node
node_modules/
frontend/node_modules/
frontend/dist/
dist/
dist-ssr/
*.local

# Python
backend/__pycache__/
backend/*.pyc
backend/.venv/
backend/venv/
*.egg-info/
.pytest_cache/

# Models (large weights - don't commit, download separately)
models/*.pt
models/*.onnx
models/*.pth
models/*.bin
!models/README.md
!models/.gitkeep

# Data (user uploads + large imagery)
data/uploads/*
!data/uploads/.gitkeep
data/samples/*.tif
data/samples/*.tiff
data/samples/*.jpg
data/samples/*.png
!data/samples/.gitkeep

# Outputs (generated annotated images, maps, reports)
outputs/*.jpg
outputs/*.jpeg
outputs/*.png
outputs/*.tif
outputs/*.tiff
outputs/*.json
outputs/reports/*
!outputs/reports/.gitkeep
outputs/maps/*
!outputs/maps/.gitkeep
!outputs/README.md

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
.env
